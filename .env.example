# Run scripts/init-env.sh to create .env with fresh gateway secrets.
# Supply connection URLs for your existing PostgreSQL and Redis services.
# URLs may contain credentials; keep .env private. Percent-encode reserved characters.
APIGATE_DATABASE_DSN='postgresql://USER:PASSWORD@POSTGRES_HOST:5432/DATABASE?sslmode=require'
APIGATE_REDIS_URL='rediss://default:PASSWORD@REDIS_HOST:6379/0'
APIGATE_API_KEY_SECRET=replace-with-at-least-32-random-characters
APIGATE_SETUP_TOKEN=replace-with-random-setup-token
APIGATE_PUBLIC_URL=http://localhost:8080
APIGATE_IMAGE=coolqoo/better-apigate:1.0.0

# For services on the Docker host, use host.docker.internal instead of localhost.
# Local Redis without TLS uses redis://; use your provider's scheme and port.
# Optional Prometheus scrape credential (32+ characters); /metrics also accepts admin sessions.
APIGATE_METRICS_TOKEN=

# Upstream secret references configured in the admin UI resolve from this environment.
# UPSTREAM_API_TOKEN=your-upstream-secret
# APIGATE_DB_MAX_CONNS=32
# Match this client image to your PostgreSQL server major version for backups.
# APIGATE_POSTGRES_CLIENT_IMAGE=postgres:17.10-alpine

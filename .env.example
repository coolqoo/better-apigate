# Generate real secrets with scripts/init-env.sh. Never commit .env.
POSTGRES_PASSWORD=replace-with-random-hex
# Allocate at least 4 GiB to PostgreSQL with the default buffer setting.
POSTGRES_SHARED_BUFFERS=1GB
REDIS_PASSWORD=replace-with-random-hex
APIGATE_API_KEY_SECRET=replace-with-at-least-32-random-characters
APIGATE_SETUP_TOKEN=replace-with-random-setup-token
APIGATE_PUBLIC_URL=http://localhost:8080

# Optional Prometheus scrape credential (32+ characters); /metrics also accepts admin sessions.
APIGATE_METRICS_TOKEN=
